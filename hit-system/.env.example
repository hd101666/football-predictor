# 命中系统 环境变量模板
# 复制为项目根目录 .env 后填入真实值。**本文件只写变量名，绝不写真实值。**
# 未配置的变量会导致对应爬虫不可用，但不影响其他爬虫运行。

# ══════════════ 数据库 ══════════════
# 默认 ./data/sports_data.db（SQLite）。可指向其他绝对路径
DB_DIR=./data

# ══════════════ 企鹅体育 Qiety（软盘口 / YB）══════════════
# 28_qiety_yb_scraper_v2 使用 token 方式
QIETY_TOKEN=
QIETY_CUID=
# 30_qiety_history 使用账号方式（注意：该脚本硬编码的旧域名已失效，见 CRAWLER_INDEX.md）
QIETY_ACCOUNT=
QIETY_PASSWORD=

# ══════════════ The Odds API ══════════════
# 35_theoddsapi_multi_scraper 支持多 key 轮换，按余额倒序选槽
THE_ODDS_API_KEY_1=
THE_ODDS_API_KEY_2=
THE_ODDS_API_KEY_3=
THE_ODDS_API_KEY_4=
THE_ODDS_API_KEY_5=
THE_ODDS_API_KEY_6=
THE_ODDS_API_KEY_7=
THE_ODDS_API_KEY_8=
THE_ODDS_API_KEY_9=
# 每日调用上限（可选，默认不限制）
# THEODDS_DAILY_CREDIT_CAP=2000
# 低于该余额的 key 不再调用（可选）
# QQSJ_ODDS_API_MIN_REMAINING=50

# ══════════════ Pinnacle ══════════════
# 12_/15_ pinnacle 爬虫使用的 guest key
PINNACLE_GUEST_KEY=

# ══════════════ API-Football (api-sports.io) ══════════════
APISPORTS_KEY_1=
APISPORTS_KEY_2=
APISPORTS_KEY_3=

# ══════════════ RapidAPI（13_bet365 等）══════════════
RAPIDAPI_KEY=
RAPIDAPI_KEY_SPARE=

# ══════════════ SportMonks ══════════════
# 注意：Free Plan 无 football 访问权限，需付费订阅
SPORTMONKS_API_KEY=
SPORTMONKS_TOKEN=

# ══════════════ Betfair Exchange ══════════════
# 需在 developer.betfair.com 注册应用获取；未配置时 24_ 爬虫会跳过
BETFAIR_API_KEY=

# ══════════════ 其他 ══════════════
SHARPAPI_KEY=
TAVILY_API_KEY=
SPORTRADAR_API_KEY=
THESPORTS_USER=
THESPORTS_SECRET=

# ══════════════ 推送通知（可选）══════════════
FEISHU_WEBHOOK=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
PUSHPLUS_TOKEN=
WXPUSHER_TOKEN=

# ══════════════ 运行模式 ══════════════
# paper = 只生成投注单不实际下注（推荐，默认）
# live  = 实盘
BETTING_MODE=paper
ENABLE_LIVE_BETTING=0
